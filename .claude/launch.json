{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "design-board",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--bind",
        "127.0.0.1"
      ],
      "port": 4173
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:web"
      ],
      "port": 3000,
      "url": "http://app.localhost:3000"
    },
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:admin"
      ],
      "port": 3001
    }
  ]
}