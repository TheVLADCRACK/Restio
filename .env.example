# Restio — variables d'environnement (AUCUNE vraie valeur ici).
# Copier dans apps/web/.env.local et apps/admin/.env.local (ignorés par git).
# Production : variables Vercel, un projet par application, jamais partagées entre web et admin.

# ---------- apps/web ----------
# Rôle restio_app sur la branche Neon production (jamais neondb_owner)
DATABASE_URL=postgresql://restio_app:CHANGE_ME@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Instance Neon Auth des restaurateurs (branche production)
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.c-8.eu-central-1.aws.neon.tech/neondb/auth
# openssl rand -base64 32  (différent pour chaque application et chaque environnement)
NEON_AUTH_COOKIE_SECRET=
ROOT_HOST=localhost:3000
APP_HOST=app.localhost:3000
# openssl rand -base64 48 (pseudonymisation des IP et emails dans les limites de fréquence)
IP_HASH_SALT=

# ---------- apps/admin ----------
# Rôle restio_admin_ops sur la branche production
PROD_DATABASE_URL=postgresql://restio_admin_ops:CHANGE_ME@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Rôle restio_admin_app sur la branche admin, base restio_admin
ADMIN_DATABASE_URL=postgresql://restio_admin_app:CHANGE_ME@ep-yyyy-pooler.eu-central-1.aws.neon.tech/restio_admin?sslmode=require
# Instance Neon Auth de la branche admin (adresse différente de celle des restaurateurs)
# NEON_AUTH_BASE_URL=https://ep-yyyy.neonauth.c-8.eu-central-1.aws.neon.tech/restio_admin/auth
# NEON_AUTH_COOKIE_SECRET=
# Adresses autorisées, séparées par des virgules
ADMIN_ALLOWED_EMAILS=

# ---------- migrations uniquement (poste du propriétaire ou CI dédiée, jamais dans Vercel) ----------
APP_MIGRATION_DATABASE_URL=
ADMIN_MIGRATION_DATABASE_URL=
